# Copy to .env (git-ignored) for docker compose.

# Entra app registration "D365 Portal - Web" (SPA, sign-in)
WEB_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Entra app registration "D365 Portal - API" (exposes scope access_as_user)
API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Platform owner (super-admin): your Entra directory id + your user's Object ID
SUPERADMIN_ENTRA_TENANT_ID=
SUPERADMIN_OBJECT_ID=

# Optional demo data: creates tenant "demo" with this email as TenantAdmin
SEED_ENABLED=true
SEED_ADMIN_EMAIL=you@yourcompany.com
SEED_COMPANIES=USMF,DEMF
# Entra directory (tid) the seeded admin signs in from — usually your own tenant id
SEED_ENTRA_TENANT_IDS=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
