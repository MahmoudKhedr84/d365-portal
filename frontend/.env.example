# Copy to .env.local for `npm run dev`.
# Client id of the SPA app registration ("D365 Portal - Web").
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Multi-tenant sign-in: "organizations" (work/school accounts from any Entra tenant).
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations
# Scope exposed by the API app registration ("D365 Portal - API").
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# Leave as /api: Vite dev server proxies it to the backend.
VITE_API_BASE_URL=/api
# Where the Vite dev proxy forwards /api.
VITE_DEV_API_PROXY=http://localhost:5080
